{
  "name": "@iimransarwar/sharepoint-mcp",
  "version": "0.1.3",
  "description": "SharePoint MCP is a Model Context Protocol (MCP) server for Microsoft Graph with enhanced search, metadata extraction, pagination, and caching.",
  "license": "MIT",
  "author": "Imran Sarwar",
  "main": "build/main.js",
  "type": "module",
  "keywords": [
    "mcp",
    "graph",
    "microsoft",
    "graph",
    "model",
    "context",
    "protocol"
  ],
  "bin": {
    "sharepoint-mcp": "build/main.js"
  },
  "scripts": {
    "build": "tsc",
    "build:unix": "tsc && chmod 755 build/main.js",
    "start": "node build/main.js",
    "test": "npm run build && node --experimental-vm-modules node_modules/.bin/jest",
    "test:coverage": "npm run build && node --experimental-vm-modules node_modules/.bin/jest --coverage"
  },
  "files": [
    "build",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/identity-cache-persistence": "^1.3.2",
    "@azure/msal-node-extensions": "^5.5.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "isomorphic-fetch": "^3.0.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "node-html-parser": "^9.0.4",
    "pdfjs-dist": "^6.3.289",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "^3.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/isomorphic-fetch": "^0.0.39",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.3",
    "@types/yauzl": "^3.4.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "js-yaml@3": {
      "argparse": "^2.0.1"
    }
  }
}
